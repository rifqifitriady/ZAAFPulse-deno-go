{
  "name": "zaafpulse",
  "version": "1.1.0",
  "description": "ZAAFPulse: AI command center and agentic workspace for macOS, Linux and Windows.",
  "main": "server.js",
  "bin": {
    "zaafpulse": "bin/zaafpulse.js"
  },
  "private": true,
  "type": "commonjs",
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "demo": "node bin/zaafpulse.js start --demo",
    "mcp": "node mcp.js",
    "mcp:register": "node scripts/register-mcp.js",
    "test": "node --test test/*.test.js",
    "typecheck": "deno check --sloppy-imports lib/gateway lib/cost lib/governance lib/money.js lib/types.js",
    "media": "node scripts/capture-media.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "postject": "1.0.0-alpha.6"
  }
}
