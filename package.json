{
  "name": "zaafpulse",
  "version": "1.1.0",
  "description": "ZAAFPulse: AI command center and agentic workspace for macOS, Linux and Windows.",
  "main": "server.js",
  "bin": {
    "zaafpulse": "bin/zaafpulse.js"
  },
  "private": true,
  "type": "commonjs",
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "demo": "node bin/zaafpulse.js start --demo",
    "mcp": "node mcp.js",
    "mcp:register": "node scripts/register-mcp.js",
    "test": "node --test test/*.test.js",
    "test:contract": "node --test --test-concurrency=1 test/contract/*.test.js",
    "test:go": "go -C gw vet ./... && go -C gw test -count=1 ./...",
    "gw:dev": "node scripts/gw-dev.js",
    "gw:build": "go -C gw build -o bin/ ./cmd/zaafpulse-gw",
    "typecheck": "deno check --sloppy-imports lib/front lib/gateway lib/cost lib/governance lib/money.js lib/types.js",
    "build": "deno run -q --no-prompt --allow-read --allow-write=dist --allow-run=git,tar,deno --allow-env=PATH --ignore-env scripts/build-deno.js",
    "media": "node scripts/capture-media.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "24.19.2"
  }
}
